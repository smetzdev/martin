---
// Fetched on the server, so the API key never reaches the browser.
const apiKey = import.meta.env.API_NINJAS_KEY;

let joke: string | undefined;
let error: string | undefined;

if (!apiKey) {
  error = "API_NINJAS_KEY is missing in .env";
} else {
  try {
    const res = await fetch("https://api.api-ninjas.com/v1/chucknorris", {
      headers: { "X-Api-Key": apiKey },
    });
    if (!res.ok) throw new Error(`API Ninjas responded with ${res.status}`);
    const data = await res.json();
    joke = data.joke;
    if (!joke) throw new Error("API Ninjas response contained no joke");
  } catch (e) {
    error = e instanceof Error ? e.message : String(e);
  }
}

if (error) console.warn(`[ChuckJoke] ${error}`);
---

<figure class="joke">
  {
    joke ? (
      <blockquote>{joke}</blockquote>
    ) : (
      <p class="fallback">No Chuck Norris joke available right now.</p>
    )
  }
  <figcaption>Chuck Norris fact</figcaption>
</figure>

<style>
  .joke {
    margin: 0 0 20px;
    padding: 16px;
    max-width: 480px;
    background: rgba(255, 255, 255, 0.7);
    border-left: 4px solid #bc52ee;
    border-radius: 12px;
  }

  blockquote,
  .fallback {
    margin: 0;
    color: #111827;
    font-size: 18px;
    line-height: 1.5;
  }

  .fallback {
    color: #4b5563;
  }

  figcaption {
    margin-top: 8px;
    color: #4b5563;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
